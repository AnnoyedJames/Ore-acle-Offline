\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces A crafting recipe grid (e.g., Daylight Detector), showing the precise ingredient requirements needed to construct items. A 1-cell shift or incorrect material variant produces an entirely different item or fails silently; this scale of structured visual-spatial knowledge is ill-suited to parametric LLM recall.}}{3}{figure.caption.2}\protected@file@percent }
\newlabel{fig:crafting_recipe_book}{{2}{3}{A crafting recipe grid (e.g., Daylight Detector), showing the precise ingredient requirements needed to construct items. A 1-cell shift or incorrect material variant produces an entirely different item or fails silently; this scale of structured visual-spatial knowledge is ill-suited to parametric LLM recall}{figure.caption.2}{}}
